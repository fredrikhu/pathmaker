# Copy to /etc/pathmaker/api.env on the server (chmod 600, owned by the service user).
# Nothing here belongs in git — the two Discord values are credentials.

# Where the browser app is served from. Also the only origin allowed to make writes.
PATHMAKER_APP_ORIGIN=https://pathmaker.example.com

# The API listens on loopback only; nginx is what faces the internet.
PATHMAKER_HOST=127.0.0.1
PATHMAKER_PORT=8787

# SQLite file. The service user needs write access to this directory.
PATHMAKER_DB=/var/lib/pathmaker/pathmaker.db

# From https://discord.com/developers/applications → your app → OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must match a redirect URI registered on the Discord application exactly.
DISCORD_REDIRECT_URI=https://pathmaker.example.com/api/auth/discord/callback

# Signs the session and OAuth-state cookies. Generate with:  openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=

# How long a sign-in lasts without re-authenticating.
PATHMAKER_SESSION_DAYS=30
